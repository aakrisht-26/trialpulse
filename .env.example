# Copy to .env and fill in only what the current step needs. Never commit .env.
# Environment variables with the same names take precedence over this file.

# Hugging Face token, after accepting the brbk/clinical_trials_history terms (Step 2)
HF_TOKEN=

# Local Postgres from docker-compose.yml:
# postgresql+psycopg://trialpulse:trialpulse@127.0.0.1:15432/trialpulse
# DATABASE_URL names the local Postgres only: tests and alembic refuse any other host.
DATABASE_URL=
# Neon's DIRECT URL (the host without -pooler), for the daily job and the laptop commands.
# Neon's console may offer the pooled URL first; switch "Connection pooling" off to copy the
# direct one. Migrate Neon with: uv run python -m trialpulse.live.migrate (it asks for the URL).
NEON_DATABASE_URL=

# MLflow tracking on DagsHub
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# Groq API, used for reason labeling in Step 6 only
GROQ_API_KEY=

# Key of the keyed sponsor ids of the live system (ADR 0044). A long random value, kept
# only here and in GitHub secrets; never print or commit it.
SPONSOR_ID_KEY=

# The API's read-only pooled URL on Neon (ADR 0049), for the role made by
# trialpulse.live.api_role. Set it as a Hugging Face Spaces secret too.
API_DATABASE_URL=
